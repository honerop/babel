# Browser control logic is Babel; Chromium provides web rendering and UI.
use desktop.browser
home = environ "HOME"
configured = environ "BABEL_BROWSER_DIR"
base = if == configured "" concat home "/.local/share/babel-browser" configured
profile = pathjoin base "profile"
extensions = pathjoin base "extensions"
ublock = pathjoin extensions "ublock-origin-lite"
vimium = pathjoin extensions "vimium"
dark = pathjoin extensions "dark-reader"
loaded = concat concat concat concat ublock "," vimium "," dark
arguments = argv _
url = if > size arguments 0 astext get arguments 0 "about:blank"
result = desktop_browser_open "chromium" profile loaded url
print if asbool field result "ok" "Browser closed" astext field result "error"
